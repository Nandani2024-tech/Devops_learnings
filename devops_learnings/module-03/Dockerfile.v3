# STAGE : Builder 

FROM python:3.11 AS builder 
WORKDIR /build 
COPY app/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt



# RUNTIME 

FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /install /usr/local

COPY app/app.py .

EXPOSE 8000

CMD ["python", "app.py"]


